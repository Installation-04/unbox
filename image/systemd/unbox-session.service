[Unit]
Description=UnboxOS console session (gamescope + shell)
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-logind.service
Wants=systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=unbox
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/gamescope -f -W 1920 -H 1080 -- /usr/libexec/unbox-shell
Restart=always
RestartSec=0.5
StartLimitIntervalSec=0

[Install]
WantedBy=graphical.target
